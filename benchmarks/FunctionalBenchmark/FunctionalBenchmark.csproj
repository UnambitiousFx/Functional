<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Override the inherited single TargetFramework to also build net11.0, so the C# 15
             union-matching benchmark can be built and run. -->
        <TargetFramework />
        <TargetFrameworks>$(LatestTargetFramework);net11.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Ardalis.Result"/>
        <PackageReference Include="BenchmarkDotNet"/>
        <PackageReference Include="FluentResults"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Functional\Functional.csproj"/>
    </ItemGroup>

</Project>
